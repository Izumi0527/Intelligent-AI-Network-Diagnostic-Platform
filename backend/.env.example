# 应用设置
APP_ENV=development
DEBUG=true
API_PREFIX=/api
APP_NAME="AI智能网络故障分析平台"
APP_VERSION=0.1.0

# 服务器设置
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,*

# 安全设置

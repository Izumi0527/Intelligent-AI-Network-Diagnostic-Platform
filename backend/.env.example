# AI模型配置
ANTHROPIC_API_KEY=your-key
ANTHROPIC_API_BASE=https://openai.com/v1
CLAUDE_MODEL_VERSION=claude-opus-4-7
OPENAI_API_KEY=your-key
OPENAI_API_BASE=https://claude.com/v1
DEEPSEEK_API_KEY=your-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_VERSION=deepseek-v4-pro
AI_ENABLED=true

# OpenAI模型配置（2026最新先进模型）
OPENAI_MODELS=gpt-5.5,gpt-5.4-mini
OPENAI_MODEL_NAMES=GPT-5.5,GPT-5.4 Mini
OPENAI_MODEL_DESCRIPTIONS=OpenAI最新旗舰模型，适合复杂推理、代码和智能体任务,高性价比先进模型，适合快速推理和日常分析
OPENAI_MODEL_MAX_TOKENS=1050000,400000

# Claude模型配置（2026最新先进模型）
CLAUDE_MODELS=claude-opus-4-7,claude-sonnet-4-6,claude-haiku-4-5
CLAUDE_MODEL_NAMES=Claude Opus 4.7,Claude Sonnet 4.6,Claude Haiku 4.5
CLAUDE_MODEL_DESCRIPTIONS=Anthropic最强旗舰模型，适合复杂推理和长时间编码任务,高性能通用模型，适合代码、分析和智能体任务,快速轻量模型，适合低延迟对话和批量处理
CLAUDE_MODEL_MAX_TOKENS=1000000,1000000,200000

# DeepSeek模型配置（2026最新先进模型）
DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
DEEPSEEK_MODEL_NAMES=DeepSeek-V4-Pro,DeepSeek-V4-Flash
DEEPSEEK_MODEL_DESCRIPTIONS=DeepSeek最新旗舰模型，默认启用推理模式，适合复杂网络诊断,DeepSeek快速高性价比模型，适合常规对话和日志分析
DEEPSEEK_MODEL_MAX_TOKENS=1000000,1000000

# Deepseek API配置
DEEPSEEK_API_ENABLED=true
DEEPSEEK_TIMEOUT=30  # 请求超时时间(秒)
DEEPSEEK_MAX_TOKENS=4096  # 最大生成令牌数

# 会话配置
SESSION_IDLE_TIMEOUT=600  # 10分钟超时
MAX_TERMINAL_SESSIONS=5   # 最大同时活跃会话数

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=standard  # 可选: standard 或 json
